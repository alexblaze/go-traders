{
  "name": "nepse-trading-platform",
  "private": true,
  "version": "0.1.0",
  "description": "NEPSE AI trading signal & research platform (decision-support only, not financial advice)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./apps/api --filter ./apps/worker --filter ./apps/web run build",
    "dev:api": "pnpm --filter @nepse/api dev",
    "dev:worker": "pnpm --filter @nepse/worker dev",
    "dev:web": "pnpm --filter @nepse/web dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --project unit && pnpm --filter @nepse/web test",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "pnpm --filter @nepse/database run generate",
    "db:migrate": "pnpm --filter @nepse/database run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @nepse/database run migrate:dev",
    "db:seed": "pnpm --filter @nepse/database run seed",
    "lint": "pnpm -r run typecheck",
    "test:web": "pnpm --filter @nepse/web test",
    "test:all": "vitest run && pnpm --filter @nepse/web test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
