# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# ── Database (docker compose builds DATABASE_URL from these) ───────────────
POSTGRES_USER=nepse
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=nepse
# For running the API/worker outside Docker:
DATABASE_URL=postgresql://nepse:CHANGE_ME_postgres_password@localhost:5432/nepse
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# At least 32 random chars, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_long_random_secret_value
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# Set true when served over HTTPS
COOKIE_SECURE=false
# Requests per minute per user (or IP when anonymous)
RATE_LIMIT_MAX=100

# ── Initial admin (created by the seed if both are set) ─────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_Admin123

# Seed DEMO data (synthetic, clearly labelled) on first start
SEED_ON_START=true
SEED_DEMO_DATA=true

# ── Market data ─────────────────────────────────────────────────────────────
# csv | mock | nepse
MARKET_DATA_PROVIDER=csv
MARKET_DATA_CSV_DIR=./data/sample
# Only for MARKET_DATA_PROVIDER=nepse (licensed vendor / your own gateway; see docs)
NEPSE_API_BASE_URL=
NEPSE_API_KEY=
NEPSE_RATE_LIMIT_PER_MINUTE=30

# ── AI analyst ──────────────────────────────────────────────────────────────
# template (rule-based, no external calls) | anthropic
AI_PROVIDER=template
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Email notifications (optional; emails are logged when unset) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@nepse-platform.local

# ── Safety ──────────────────────────────────────────────────────────────────
# Live trading is not implemented. Keep false.
LIVE_TRADING_ENABLED=false

# ── Worker schedules (cron, Asia/Kathmandu) ─────────────────────────────────
WORKER_CONCURRENCY=4
SIGNAL_CRON=0 16 * * 0-4
ALERT_CRON=*/5 * * * *

# ── Optional: override base images (e.g. a registry mirror) ─────────────────
# NODE_IMAGE=node:22-bookworm-slim
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
