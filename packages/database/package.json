{
  "name": "@nepse/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "prisma": { "seed": "tsx src/seed.ts" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nepse/backtesting": "workspace:*",
    "@nepse/indicators": "workspace:*",
    "@nepse/market-data": "workspace:*",
    "@nepse/shared": "workspace:*",
    "@nepse/strategies": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "zod": "^4.1.12",
    "prisma": "6.19.3"
  },
  "devDependencies": { "tsx": "^4.20.0" }
}
